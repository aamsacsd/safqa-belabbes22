# Copiez ce fichier en .env :  cp .env.example .env
APP_ENV=development            # production en ligne (SECRET_KEY devient obligatoire)
SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///safqa.db

# Compte admin créé au 1er lancement (laissez le mot de passe vide = généré et affiché dans le terminal)
ADMIN_EMAIL=admin@safqa.dz
ADMIN_PASSWORD=
ADMIN_PHONE=0500000000

# Données de démonstration (offres fictives marquées DÉMO)
DEMO_DATA=true

# Modèle freemium
FREE_PLAN_DELAY_HOURS=48
PREMIUM_PRICE_DZD=1500
PREMIUM_DAYS=30
PAYMENT_MODE=simulation        # simulation = activation immédiate (démo) | manual = validation admin

# SMS (récupération du mot de passe) : console | demo (affiche le code à l'écran) | webhook
SMS_MODE=demo
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Telegram (alertes Premium) : créez un bot avec @BotFather
TELEGRAM_TOKEN=
PUBLIC_BASE_URL=http://localhost:5000

# Collecte automatique (optionnel, à adapter au site visé)
PORTAL_URL=https://www.marches-publics.gov.dz/
SCRAPE_URL=
SCRAPE_ITEM_SELECTOR=article
SCRAPE_TITLE_SELECTOR=h2 a, h3 a, a
SCRAPE_AGENCY_SELECTOR=.agency
SCRAPE_DEADLINE_SELECTOR=.deadline
SCRAPE_ONLY_LOCAL=true
